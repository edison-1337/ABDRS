# =============================================================================
# Barangay Document Request System — environment template
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed. This file is the ONLY env file tracked in source control, and
# it must never contain a real credential.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public origin of this app. Used to build absolute links inside SMS text.
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins. Empty means same-origin only.
CORS_ORIGINS=

# --- Database (MySQL) --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=abdrs
DB_USER=abdrs_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Set to true only for local throwaway databases.
DB_ALLOW_RESET=false

# --- Sessions & credentials -------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Residents must verify their phone number before a request counts as verified.
RESIDENT_OTP_ENABLED=true
RESIDENT_OTP_TTL_MINUTES=10

# --- SMS provider -----------------------------------------------------------
# `textbee` talks to the real gateway. `mock` logs instead of sending and is
# the correct value for local development and automated tests.
SMS_PROVIDER=mock
SMS_FROM_LABEL=Barangay Office
# Absolute or relative clock skew tolerance for webhook signature checks.
SMS_WEBHOOK_TOLERANCE_SECONDS=300

# Textbee credentials. The API key grants full account access — treat it as a
# password. Server-side only; never expose it under a public/ path.
TEXTBEE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# Optional. Leave blank to let Textbee pick the default/most-recent device.
TEXTBEE_DEVICE_ID=
# Shared secret Textbee uses to HMAC-sign delivery webhooks.
TEXTBEE_WEBHOOK_SECRET=
# Optional SIM selector for dual-SIM devices.
TEXTBEE_SIM_SUBSCRIPTION_ID=

# --- SMS outbox worker -------------------------------------------------------
# Textbee sustains roughly 10-15 messages/minute per registered phone.
SMS_THROTTLE_PER_MINUTE=12
SMS_MAX_ATTEMPTS=5
SMS_POLL_INTERVAL_MS=5000
SMS_BACKOFF_BASE_MS=30000